{
  "$schema": "https://opencode.ai/config.json",
  "permission": {
    "bash": {
      "rm -rf *": "deny"
    }
  },
  "mcp": {
    "shadcn": {
      "type": "local",
      "command": [
        "bunx",
        "shadcn@latest",
        "mcp"
      ],
      "enabled": true
    },
    "playwright": {
      "type": "local",
      "command": [
        "bunx",
        "@playwright/mcp@latest",
        "--browser=chromium",
        "--executable-path=/usr/bin/chromium"
      ],
      "enabled": true
    }
    // "context7": {
    //   "type": "local",
    //   "command": [
    //     "bunx",
    //     "-y",
    //     "@upstash/context7-mcp"
    //     // "--api-key",
    //     // "YOUR_API_KEY"
    //   ],
    //   "enabled": true
    // }
  }
}
